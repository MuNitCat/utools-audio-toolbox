{
  "main": "index.html",
  "logo": "logo.png",
  "preload": "preload/index.js",
  "pluginSetting": {
    "single": true,
    "height": 640
  },
  "features": [
    {
      "code": "audio-batch",
      "description": "音频批量处理：格式转换、视频提取音频、码率压缩、裁剪、合并、变速增益、响度标准化、重采样、降噪、标签封面、静音切分、频谱图",
      "cmds": [
        "音频批量处理",
        "音频转换",
        "音频压缩",
        {
          "type": "files",
          "label": "音频批量处理",
          "fileType": "file",
          "extensions": [
            "mp3",
            "m4a",
            "m4b",
            "aac",
            "flac",
            "wav",
            "wave",
            "ogg",
            "oga",
            "opus",
            "alac",
            "aiff",
            "aif",
            "ape",
            "wma",
            "mka",
            "caf",
            "amr",
            "mp4",
            "m4v",
            "mkv",
            "mov",
            "avi",
            "webm",
            "flv",
            "wmv",
            "ts",
            "m2ts",
            "mpg",
            "mpeg",
            "3gp",
            "ogv",
            "vob",
            "rmvb"
          ],
          "minLength": 1,
          "maxLength": 200
        }
      ]
    }
  ],
  "tools": {
    "audio_info": {
      "description": "读取音频文件的元信息（时长、码率、采样率、声道、位深、标签、是否带内嵌封面）。不修改文件。需要知道文件参数、或为后续处理做判断时先调它。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "inputPaths": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1,
            "description": "音频文件绝对路径列表"
          }
        },
        "required": ["inputPaths"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "results": { "type": "array", "description": "每个文件的探测结果" }
        }
      }
    },
    "audio_convert": {
      "description": "音频格式转换 / 码率压缩 / 重采样。支持 mp3、m4a、aac(ADTS)、flac、wav、ogg、opus、alac。注意：输出为 aac 时是无标签的裸流，一般应输出 m4a。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "inputPaths": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1,
            "description": "输入文件绝对路径列表"
          },
          "format": {
            "type": "string",
            "enum": ["mp3", "m4a", "aac", "flac", "wav", "ogg", "opus", "alac"],
            "description": "目标格式"
          },
          "bitrate": { "type": "number", "minimum": 32, "maximum": 512, "description": "有损格式码率 kbps，如 192" },
          "quality": { "type": "string", "description": "MP3 VBR 质量 0-9（0 最高），设置后忽略 bitrate" },
          "sampleRate": {
            "type": "number",
            "enum": [8000, 11025, 16000, 22050, 32000, 44100, 48000, 96000],
            "description": "目标采样率 Hz"
          },
          "channels": { "type": "number", "enum": [1, 2], "description": "目标声道数" },
          "copy": { "type": "boolean", "description": "true 表示同编码直转（不重编码，最快，但不能改码率/采样率）" },
          "outputDir": { "type": "string", "description": "输出目录绝对路径；不传则与原文件同目录" },
          "overwrite": { "type": "boolean", "description": "是否允许覆盖同名文件，默认 false" },
          "suffix": { "type": "string", "description": "输出文件名后缀，例如 _norm" }
        },
        "required": ["inputPaths", "format"]
      }
    },
    "audio_extract": {
      "description": "从视频文件（mp4/mkv/mov/webm/avi 等）里提取音轨，画面与字幕全部丢弃。trackMode=first 只取第一条（默认），all 每条音轨各导一个文件（命名 原名_1/2…，不加额外后缀），mix 把所有音轨混合成一条（走 amix，需要重编码）。先调 audio_info 看 audioStreams 判断有几条轨。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "inputPaths": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1,
            "description": "视频文件绝对路径列表"
          },
          "trackMode": {
            "type": "string",
            "enum": ["first", "all", "mix"],
            "description": "音轨处理：first 只取第一条（默认）/ all 每条各导一个文件 / mix 混合成一条"
          },
          "format": {
            "type": "string",
            "enum": ["mp3", "m4a", "aac", "flac", "wav", "ogg", "opus", "alac"],
            "description": "目标音频格式，默认 m4a"
          },
          "bitrate": { "type": "number", "minimum": 32, "maximum": 512, "description": "有损格式码率 kbps；不传则沿用源音轨码率（夹在 64–320）" },
          "quality": { "type": "string", "description": "MP3 VBR 质量 0-9（0 最高），设置后忽略 bitrate" },
          "sampleRate": {
            "type": "number",
            "enum": [8000, 11025, 16000, 22050, 32000, 44100, 48000, 96000],
            "description": "目标采样率 Hz"
          },
          "channels": { "type": "number", "enum": [1, 2], "description": "目标声道数" },
          "copy": { "type": "boolean", "description": "true 表示直接复制音轨（不重编码，最快；源编码与容器不兼容时会失败）" },
          "outputDir": { "type": "string", "description": "输出目录绝对路径；不传则与原文件同目录" },
          "overwrite": { "type": "boolean", "description": "是否允许覆盖同名文件，默认 false" },
          "suffix": { "type": "string", "description": "输出文件名后缀，留空表示不改名，例如 _converted" }
        },
        "required": ["inputPaths"]
      }
    },
    "audio_clip": {
      "description": "按时间裁剪音频片段，可选淡入淡出。start/duration/end 支持 \"00:01:30\" 或纯秒数。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "inputPaths": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1,
            "description": "输入文件绝对路径列表"
          },
          "start": { "type": "string", "description": "起点，如 00:00 或 90.5" },
          "duration": { "type": "string", "description": "时长，如 00:30；与 end 二选一" },
          "end": { "type": "string", "description": "终点时间；给了 end 则忽略 duration" },
          "fadeIn": { "type": "number", "description": "淡入秒数" },
          "fadeOut": { "type": "number", "description": "淡出秒数" },
          "copy": { "type": "boolean", "description": "流复制（快但切点不精确）" },
          "format": { "type": "string", "enum": ["mp3", "m4a", "flac", "wav", "ogg", "opus"], "description": "输出格式" },
          "outputDir": { "type": "string", "description": "输出目录绝对路径；不传则与原文件同目录" },
          "overwrite": { "type": "boolean", "description": "是否允许覆盖同名文件，默认 false" },
          "suffix": { "type": "string", "description": "输出文件名后缀" }
        },
        "required": ["inputPaths", "start"]
      }
    },
    "audio_merge": {
      "description": "把多个音频按给定顺序合并成一个文件。参数一致时自动流复制（快），否则重编码。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "inputPaths": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 2,
            "description": "按顺序排列的输入文件绝对路径列表"
          },
          "format": { "type": "string", "enum": ["mp3", "m4a", "flac", "wav", "ogg", "opus"], "description": "输出格式" },
          "bitrate": { "type": "number", "description": "有损格式码率 kbps" },
          "mode": { "type": "string", "enum": ["auto", "copy", "reencode"], "description": "auto 自动 / copy 强制流复制 / reencode 强制重编码" },
          "outputName": { "type": "string", "description": "输出文件名（不含扩展名），留空用第一个文件名" },
          "outputDir": { "type": "string", "description": "输出目录绝对路径；不传则与原文件同目录" },
          "overwrite": { "type": "boolean", "description": "是否允许覆盖同名文件，默认 false" }
        },
        "required": ["inputPaths"]
      }
    },
    "audio_edit": {
      "description": "对音频做变速不变调、音量增益、淡入淡出，可任意组合（合成一条滤镜链，只重编码一次）。至少给一个参数。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "inputPaths": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1,
            "description": "输入文件绝对路径列表"
          },
          "speed": { "type": "number", "minimum": 0.25, "maximum": 4, "description": "速度倍率 0.25-4，1 表示不变" },
          "gainDb": { "type": "number", "minimum": -30, "maximum": 30, "description": "增益 dB，正数变大" },
          "fadeIn": { "type": "number", "description": "淡入秒数" },
          "fadeOut": { "type": "number", "description": "淡出秒数" },
          "format": { "type": "string", "enum": ["mp3", "m4a", "flac", "wav", "ogg", "opus"], "description": "输出格式" },
          "bitrate": { "type": "number", "description": "有损格式码率 kbps" },
          "outputDir": { "type": "string", "description": "输出目录绝对路径；不传则与原文件同目录" },
          "overwrite": { "type": "boolean", "description": "是否允许覆盖同名文件，默认 false" },
          "suffix": { "type": "string", "description": "输出文件名后缀" }
        },
        "required": ["inputPaths"]
      }
    },
    "audio_normalize": {
      "description": "按 LUFS 做响度标准化（多文件音量统一首选）。默认两遍法，先测量再套用，结果更准。音声/ASMR 建议 targetLufs=-18。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "inputPaths": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1,
            "description": "输入文件绝对路径列表"
          },
          "targetLufs": { "type": "number", "minimum": -70, "maximum": -5, "description": "目标响度 LUFS，常用 -16 / -18 / -20 / -23" },
          "truePeak": { "type": "number", "minimum": -9, "maximum": 0, "description": "真峰值 dBTP，默认 -3" },
          "lra": { "type": "number", "minimum": 1, "maximum": 50, "description": "响度范围 LRA，默认 11" },
          "twoPass": { "type": "boolean", "description": "是否两遍法，默认 true" },
          "format": { "type": "string", "enum": ["mp3", "m4a", "flac", "wav", "ogg", "opus"], "description": "输出格式" },
          "bitrate": { "type": "number", "description": "有损格式码率 kbps" },
          "outputDir": { "type": "string", "description": "输出目录绝对路径；不传则与原文件同目录" },
          "overwrite": { "type": "boolean", "description": "是否允许覆盖同名文件，默认 false" },
          "suffix": { "type": "string", "description": "输出文件名后缀" }
        },
        "required": ["inputPaths"]
      }
    },
    "audio_denoise": {
      "description": "FFT 降噪 + 高低通滤波，去掉底噪与低频轰鸣。强度 light/medium/strong。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "inputPaths": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1,
            "description": "输入文件绝对路径列表"
          },
          "strength": { "type": "string", "enum": ["light", "medium", "strong"], "description": "降噪强度" },
          "highpass": { "type": "number", "description": "高通频率 Hz，默认 70，去低频嗡声" },
          "lowpass": { "type": "number", "description": "低通频率 Hz，默认 16000" },
          "format": { "type": "string", "enum": ["mp3", "m4a", "flac", "wav", "ogg", "opus"], "description": "输出格式" },
          "bitrate": { "type": "number", "description": "有损格式码率 kbps" },
          "outputDir": { "type": "string", "description": "输出目录绝对路径；不传则与原文件同目录" },
          "overwrite": { "type": "boolean", "description": "是否允许覆盖同名文件，默认 false" },
          "suffix": { "type": "string", "description": "输出文件名后缀" }
        },
        "required": ["inputPaths"]
      }
    },
    "audio_metadata": {
      "description": "批量写音频标签（title/artist/album 等）与内嵌封面，可选把原封面导出成图片。中文日文均可。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "inputPaths": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1,
            "description": "输入文件绝对路径列表"
          },
          "title": { "type": "string", "description": "标题，留空不改" },
          "artist": { "type": "string", "description": "艺术家，留空不改" },
          "album": { "type": "string", "description": "专辑，留空不改" },
          "albumArtist": { "type": "string", "description": "专辑艺术家，留空不改" },
          "genre": { "type": "string", "description": "流派" },
          "date": { "type": "string", "description": "年份" },
          "comment": { "type": "string", "description": "备注" },
          "coverPath": { "type": "string", "description": "封面图片绝对路径，嵌入或替换封面" },
          "extractCover": { "type": "boolean", "description": "是否同时把原内嵌封面导出成图片" },
          "coverFormat": { "type": "string", "enum": ["jpg", "png"], "description": "导出封面的格式" },
          "outputDir": { "type": "string", "description": "输出目录绝对路径；重命名模式下表示移动到该目录" },
          "suffix": { "type": "string", "description": "输出文件名后缀" },
          "overwrite": { "type": "boolean", "description": "是否允许覆盖同名文件，默认 false" }
        },
        "required": ["inputPaths"]
      }
    },
    "audio_cover": {
      "description": "提取音频内嵌封面存成 jpg/png。文件没有封面会跳过。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "inputPath": { "type": "string", "description": "输入文件绝对路径" },
          "format": { "type": "string", "enum": ["jpg", "png"], "description": "图片格式" },
          "outputPath": { "type": "string", "description": "可选：指定输出图片绝对路径" },
          "outputDir": { "type": "string", "description": "输出目录绝对路径；不传则与原文件同目录" },
          "suffix": { "type": "string", "description": "输出文件名后缀" },
          "overwrite": { "type": "boolean", "description": "是否允许覆盖同名文件，默认 false" }
        },
        "required": ["inputPath"]
      }
    },
    "audio_trim_silence": {
      "description": "去掉音频首尾的静音段，中间静音保留。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "inputPaths": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1,
            "description": "输入文件绝对路径列表"
          },
          "threshold": { "type": "number", "minimum": -60, "maximum": -10, "description": "静音阈值 dB，默认 -40" },
          "keepEdge": { "type": "number", "description": "保留边缘静音秒数，默认 0.1" },
          "format": { "type": "string", "enum": ["mp3", "m4a", "flac", "wav", "ogg", "opus"], "description": "输出格式" },
          "bitrate": { "type": "number", "description": "有损格式码率 kbps" },
          "outputDir": { "type": "string", "description": "输出目录绝对路径；不传则与原文件同目录" },
          "overwrite": { "type": "boolean", "description": "是否允许覆盖同名文件，默认 false" },
          "suffix": { "type": "string", "description": "输出文件名后缀" }
        },
        "required": ["inputPaths"]
      }
    },
    "audio_split": {
      "description": "把长音频切成多段。mode=silence 按静音自动切（先检测静音再逐段导出，适合长篇音声/ASMR）；mode=duration 按时长均分；mode=count 按份数均分。命名格式：原名_序号_开始_结束。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "inputPaths": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1,
            "description": "输入文件绝对路径列表"
          },
          "mode": { "type": "string", "enum": ["silence", "duration", "count"], "description": "切分方式" },
          "noise": { "type": "number", "minimum": -60, "maximum": -10, "description": "静音判定阈值 dB，默认 -35；切不出来就调到 -30 或更高" },
          "minSilence": { "type": "number", "minimum": 0.2, "maximum": 10, "description": "多长的静音才算分隔，秒，默认 0.8" },
          "minSegment": { "type": "number", "minimum": 1, "maximum": 600, "description": "最短片段秒数，默认 3，低于它的碎片会被并掉" },
          "pad": { "type": "number", "description": "切点两侧保留的静音秒数，默认 0.15" },
          "segmentSeconds": { "type": "number", "description": "mode=duration 时每段秒数，默认 600" },
          "count": { "type": "number", "description": "mode=count 时切几份" },
          "format": { "type": "string", "enum": ["mp3", "m4a", "flac", "wav", "ogg", "opus"], "description": "输出格式" },
          "fadeIn": { "type": "number", "description": "每段段首微淡入秒数，默认 0.08，用于消切点爆音" },
          "fadeOut": { "type": "number", "description": "每段段尾微淡出秒数，默认 0.15" },
          "bitrate": { "type": "number", "description": "有损格式码率 kbps" },
          "outputDir": { "type": "string", "description": "输出目录绝对路径；不传则与原文件同目录" },
          "overwrite": { "type": "boolean", "description": "是否允许覆盖同名文件，默认 false" }
        },
        "required": ["inputPaths"]
      }
    },
    "audio_visualize": {
      "description": "生成频谱图或波形图 PNG，用于快速判断音质、频段分布。",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "inputPath": { "type": "string", "description": "输入文件绝对路径" },
          "kind": { "type": "string", "enum": ["spectrum", "waveform"], "description": "类型" },
          "width": { "type": "number", "description": "宽度像素，默认 1920" },
          "height": { "type": "number", "description": "高度像素，默认 1080" },
          "outputDir": { "type": "string", "description": "输出目录绝对路径；不传则与原文件同目录" },
          "suffix": { "type": "string", "description": "输出文件名后缀" },
          "overwrite": { "type": "boolean", "description": "是否允许覆盖同名文件，默认 false" }
        },
        "required": ["inputPath"]
      }
    }
  },
  "development": {
    "main": "http://127.0.0.1:5180"
  }
}
